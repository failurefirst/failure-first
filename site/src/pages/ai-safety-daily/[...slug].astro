---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('aiSafetyDaily');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { id: post.id },
    }));
}

const { id } = Astro.props;
return Astro.redirect(`/blog/${id}/`, 301);
---
