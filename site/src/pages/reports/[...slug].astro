---
export const prerender = true;

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((report) => ({
    params: { slug: report.id },
  }));
}

const { slug } = Astro.params;
const newUrl = `/research/reports/${slug}`;
---
<!doctype html>
<html data-pagefind-ignore="true">
<head>
<title>Redirecting to: {newUrl}</title>
<meta http-equiv="refresh" content={`0;url=${newUrl}`}>
<meta name="robots" content="noindex">
<link rel="canonical" href={`https://failurefirst.org${newUrl}`}>
</head>
<body>
    <a href={newUrl}>Redirecting from <code>/reports/{slug}/</code> to <code>{newUrl}</code></a>
</body>
</html>
