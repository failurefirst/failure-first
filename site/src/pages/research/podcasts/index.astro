---
import ResearchLayout from '../../../layouts/ResearchLayout.astro';
import HeroSection from '../../../components/HeroSection.astro';

const podcasts = [];
---

<ResearchLayout
  title="Research Podcasts | Research | Failure-First"
  description="AI-generated audio overviews of Failure-First research reports and intelligence briefs, produced with NotebookLM."
  breadcrumbs={[{ label: "Research", href: "/research/" }, { label: "Podcasts" }]}
  status="active"
>
  <HeroSection
    title="Research<br /><em>audio</em>"
    subtitle="AI-generated overviews of our research, produced with NotebookLM"
    animation="signal"
  />

  <p>
    These audio overviews are generated by Google's NotebookLM from our published research
    reports and intelligence briefs. They provide an accessible summary of key findings
    in a conversational podcast format.
  </p>
  <p class="availability-note">
    No audio overview is currently published. Earlier entries pointed at recordings
    that were never present in site history or the media CDN, so those broken
    players have been withdrawn until a verified source artifact exists.
  </p>

  <section class="podcast-list">
    {podcasts.map((p) => (
      <div class="podcast-card card">
        <div class="podcast-header">
          <h3>{p.title}</h3>
          <div class="podcast-meta">
            {p.report && (
              <a href={p.report.href} class="podcast-report-link">{p.report.label}</a>
            )}
            <span class="podcast-format">{p.format.toUpperCase()}</span>
            <time>{p.date}</time>
          </div>
        </div>
        <p>{p.description}</p>
        <audio controls src={p.src} preload="metadata"></audio>
      </div>
    ))}
  </section>
</ResearchLayout>

<style>
  .podcast-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .podcast-card {
    border-left: 3px solid var(--accent-primary, #f59e0b);
  }

  .podcast-header {
    margin-bottom: 0.75rem;
  }

  .podcast-header h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.125rem;
  }

  .podcast-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }

  .podcast-report-link {
    color: var(--accent-primary, #f59e0b);
    text-decoration: none;
    font-weight: 600;
  }

  .podcast-report-link:hover {
    text-decoration: underline;
  }

  .podcast-format {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--border);
    border-radius: 3px;
  }

  .podcast-card p {
    font-size: 0.875rem;
    margin: 0 0 1rem 0;
    color: var(--fg-dim, #b0b8c5);
  }

  .podcast-card audio {
    width: 100%;
    height: 40px;
  }
</style>
