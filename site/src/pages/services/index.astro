---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import LinkButton from '../../components/LinkButton.astro';
import WarningBox from '../../components/WarningBox.astro';
import { stats } from '../../data/stats';

const capabilities = [
  ['Language & instruction boundaries', 'The mature attack surface. Still badly measured.', 'Jailbreaks, indirect prompt injection, system-prompt extraction, multilingual and encoded attacks, temporal and context attacks, and refusal bypass.', `${stats.promptsPlus} adversarial prompts across ${stats.modelsDisplay} models.`, 'demonstrated'],
  ['Agentic systems & tool use', 'Every tool call turns model judgment into authority.', 'Tool-boundary attacks, compromised context, indirect injection through retrieved content, multi-turn authority erosion, sub-agent and peer influence, and persistent objective drift.', '', 'demonstrated'],
  ['Multi-agent propagation', 'One compromised model is interesting. Whether it can change another model’s behaviour is the real question.', 'Cross-agent influence, attacker-generated payloads, behavioural takeover, propagation, and coordinated-agent failure.', 'BAD APPLE uses a matched A1/A2 design. The apparatus is complete; no scientific result is claimed yet.', 'active research'],
  ['Embodied AI & robotics', 'When a model moves a body, bad reasoning becomes state.', 'Robot cognition, controller and actuator boundaries, physical-consequence tracing, recovery failure, safety-policy interaction, and simulated adversarial environments.', 'We preserve the model output, accepted command, controller invocation, and what the body actually did.', 'demonstrated'],
  ['Evaluation & grader integrity', 'Sometimes the easiest system to fool is the test.', 'Benchmark leakage, grader failure, heuristic-versus-model disagreement, denominator pathology, evaluation gaming, reproducibility, and claim audits.', '', 'demonstrated'],
  ['Model integrity & safety removal', 'Safety properties can change without the application changing at all.', 'Weight-space interventions, adapters, quantisation effects, refusal and capability separation, and post-modification regression testing.', 'OBLITERATUS tests whether refusal can be removed without degrading cognition. Results are reported per checkpoint and method, not promoted into a blanket capability claim.', 'active research'],
  ['Multimodal & perceptual boundaries', 'The world can become part of the prompt.', 'Visual context conflicts, environmental text, sensor-derived instructions, and cross-modal disagreement.', 'SENSORIUM is designed; end-to-end capability has not yet been demonstrated.', 'research frontier'],
];

const engagements = [
  ['Bounded adversarial discovery', 'You give us a system and the claim you need to trust. We identify the smallest set of attacks capable of proving it wrong, run them, preserve what happened, and hand you the evidence.', 'Attack map, reproduced failures, causal interpretation, raw receipts, and the recommended next test.'],
  ['Deep red-team campaign', 'Persistent testing across context, tools, agents, and state. We mutate attacks when the evidence earns it instead of replaying a static benchmark until the spreadsheet fills up.', ''],
  ['Embodied / agentic failure investigation', 'For robots, tool-using agents, and multi-agent systems. We follow one failure from model context through policy and action into system or physical consequence.', ''],
  ['Independent evaluation & assurance', 'For benchmark, red-team, or safety claims that need someone hostile to the methodology. We attack the grader, denominator, controls, leakage assumptions, and causal interpretation—not only the model.', ''],
  ['Threat intelligence', 'Ongoing surveillance of new attack mechanisms and changes in the research frontier, translated into tests relevant to your actual architecture.', ''],
];
---

<BaseLayout title="Adversarial capabilities | Failure-First" description="Adversarial testing across language, tools, agents, models, graders, sensors, controllers, and embodied systems—with causal evidence and raw receipts." keywords="AI red teaming, agentic AI testing, embodied AI safety, evaluation audit, multi-agent security" animation="pulse" accent="cyan">
  <HeroSection title="Attack the system.<br /><em>Then attack the explanation.</em>" subtitle="Adversarial intuition, causal evidence, and receipts." animation="pulse" />

  <section class="intro">
    <p class="lede">We test where AI systems stop behaving like chatbots and start becoming part of a system.</p>
    <p>A model output is only the beginning. We follow failures through tools, agents, sensors, controllers, and other models until something changes—or until the attack dies.</p>
  </section>

  <section id="adversarial-capabilities">
    <header class="section-heading"><span>01 / attack surfaces</span><h2>Adversarial capabilities</h2></header>
    <div class="capability-grid">
      {capabilities.map(([title, thesis, body, evidence, status], index) => (
        <article class="capability-card">
          <div class="card-meta"><span>{String(index + 1).padStart(2, '0')}</span><span class={`status status-${status.replaceAll(' ', '-')}`}>{status}</span></div>
          <h3>{title}</h3><p class="thesis">{thesis}</p><p>{body}</p>
          {evidence && <p class="evidence"><strong>Evidence status:</strong> {evidence}</p>}
        </article>
      ))}
    </div>
  </section>

  <section id="ways-to-engage">
    <header class="section-heading"><span>02 / engagement formats</span><h2>Ways to engage</h2></header>
    <div class="engagement-list">
      {engagements.map(([title, body, deliverable], index) => (
        <article class="engagement-row"><span class="engagement-number">{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{body}</p>{deliverable && <p class="deliverable"><strong>Deliverable:</strong> {deliverable}</p>}</div></article>
      ))}
    </div>
  </section>

  <section class="method">
    <p class="eyebrow">The Failure-First difference</p><h2>Breaking it is only half the job.</h2>
    <p>We preserve the inputs, outputs, state transitions, accepted commands, downstream effects, controls, and grading decisions needed to challenge our own explanation. The result is not a vulnerability anecdote. It is an evidence package a hostile reviewer can inspect.</p>
  </section>

  <section class="cta-section">
    <h2>Bring us the claim you need to trust.</h2><p>We will design the cheapest bounded experiment capable of proving it wrong.</p>
    <LinkButton href="mailto:services@failurefirst.org?subject=Adversarial%20engagement" text="Start with the claim" />
    <p class="contact-alt">Or use the <a href="/contact/">contact form</a>.</p>
  </section>

  <WarningBox><p><strong>Evidence before theatre:</strong> Research-frontier capabilities are labelled as such. We do not sell an apparatus design as a demonstrated result, and we do not turn a preliminary result into a general claim.</p></WarningBox>
</BaseLayout>

<style>
  .intro { max-width: 800px; }
  .lede { color: var(--fg); font-size: clamp(1.35rem, 2.5vw, 2rem); line-height: 1.35; }
  .section-heading { border-bottom: 1px solid var(--border-dim, #333); margin-bottom: 1.5rem; padding-bottom: .75rem; }
  .section-heading span, .eyebrow { color: var(--recovery-stable, #4ade80); font-family: 'JetBrains Mono', monospace; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; }
  .section-heading h2 { margin: .35rem 0 0; }
  .capability-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  :global(body main) {
    background: linear-gradient(to bottom, rgba(5, 8, 16, 0) 0, rgba(5, 8, 16, .48) 32rem, rgba(5, 8, 16, .7) 100%);
  }
  .capability-card { background: rgba(5, 8, 16, .46); border: 1px solid rgba(122, 130, 146, .34); border-radius: 8px; padding: 1.5rem; backdrop-filter: blur(2px); }
  .capability-card:first-child { grid-column: span 2; }
  .card-meta { display: flex; justify-content: space-between; font-family: 'JetBrains Mono', monospace; font-size: .7rem; color: var(--fg-dim); text-transform: uppercase; letter-spacing: .08em; }
  .status { color: var(--recovery-stable, #4ade80); }
  .status-active-research { color: #f5b942; }
  .status-research-frontier { color: #b59cff; }
  .capability-card h3 { font-size: 1.35rem; margin: 1.25rem 0 .35rem; }
  .thesis { color: var(--fg); font-size: 1.05rem; font-style: italic; }
  .evidence, .deliverable { border-left: 2px solid var(--recovery-stable, #4ade80); color: var(--fg-dim); font-size: .875rem; margin-top: 1.25rem; padding-left: .8rem; }
  .engagement-list { border-top: 1px solid var(--border-dim, #333); }
  .engagement-row { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; border-bottom: 1px solid var(--border-dim, #333); padding: 1.5rem 0; }
  .engagement-number { color: var(--recovery-stable, #4ade80); font-family: 'JetBrains Mono', monospace; font-size: .75rem; padding-top: .35rem; }
  .engagement-row h3 { margin: 0 0 .5rem; }
  .engagement-row p, .method p:last-child { max-width: 800px; }
  .method { background: rgba(5, 8, 16, .42); border: 1px solid var(--recovery-stable, #4ade80); border-radius: 8px; padding: clamp(1.5rem, 4vw, 3rem); backdrop-filter: blur(2px); }
  .method h2 { font-size: clamp(1.8rem, 4vw, 3rem); margin: .5rem 0 1rem; }
  .cta-section { text-align: center; }
  .cta-section p { margin-left: auto; margin-right: auto; }
  .contact-alt { font-size: .85rem; margin-top: 1rem; }
  @media (max-width: 768px) {
    :global(body main) { background: linear-gradient(to bottom, rgba(5, 8, 16, 0) 0, rgba(5, 8, 16, .56) 28rem, rgba(5, 8, 16, .74) 100%); }
    .capability-grid { grid-template-columns: 1fr; }
    .capability-card:first-child { grid-column: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .capability-card, .method { backdrop-filter: none; }
  }
</style>
