---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-col">
        <p class="footer-heading">Project</p>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/manifesto/">Manifesto</a></li>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/framework/">Framework</a></li>
          <li><a href="https://github.com/adrianwedd/failure-first" target="_blank" rel="noopener">GitHub</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-heading">Research & Content</p>
        <ul>
          <li><a href="/new/">What's New</a></li>
          <li><a href="/research/">Research Hub</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/ai-safety-daily/">AI Safety Daily</a></li>
          <li><a href="/daily-paper/">Daily Paper</a></li>
          <li><a href="/search/">Search</a></li>
          <li><a href="/rss.xml">RSS Feed</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-heading">Services</p>
        <ul>
          <li><a href="/services/">Services</a></li>
          <li><a href="/policy/">Policy Briefs</a></li>
          <li><a href="/contact/">Get Involved</a></li>
          <li><a href="/about/disclosure/">Responsible Disclosure</a></li>
          <li><a href="/about/privacy/">Privacy Policy</a></li>
          <li><a href="mailto:research@failurefirst.org">research@failurefirst.org</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        <strong>Defensive posture:</strong> this site documents how AI systems fail —
        in text, in bodies, and between agents — so that whoever is building the
        defences has real failure modes to build against. If you found one we
        haven't, <a href="/about/disclosure/">tell us</a>. We would rather know.
      </p>
      <p class="footer-copyright">
        &copy; {currentYear} Failure-First Embodied AI Project |
        <a href="https://github.com/adrianwedd/failure-first" target="_blank" rel="noopener">GitHub</a>
      </p>
      <p class="footer-trademark">
        Company and organisation names and logos are trademarks of their respective
        owners; use here is for identification and does not imply endorsement.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: 4rem;
    padding: 3rem 1.5rem 2rem;
  }

  .footer-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .footer-heading {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
  }

  .footer-col li {
    margin-bottom: 0.375rem;
  }

  .footer-col a {
    color: var(--fg-muted);
    font-size: 0.8125rem;
    border-bottom: none;
  }

  .footer-col a:hover {
    color: var(--accent-primary);
  }

  .footer-bottom {
    text-align: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  .footer-bottom strong {
    color: var(--fg-dim);
  }

  .footer-copyright {
    margin-top: 0.75rem;
  }

  .footer-trademark {
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    color: var(--fg-muted);
    opacity: 0.85;
    max-width: 44rem;
    margin-left: auto;
    margin-right: auto;
  }

  .footer-copyright a {
    color: var(--fg-muted);
  }

  .footer-copyright a:hover {
    color: var(--accent-primary);
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
