---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { AnimationName, AccentName } from '../components/GenerativeBackground.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: Crumb[];
  type?: 'website' | 'article';
  kind?: 'webpage' | 'blog-post' | 'daily-paper' | 'report' | 'paper';
  publishedDate?: string;
  modifiedDate?: string;
  keywords?: string;
  noindex?: boolean;
  animation?: AnimationName;
  accent?: AccentName;
}

const {
  title,
  description,
  breadcrumbs = [],
  type,
  kind = 'webpage',
  publishedDate,
  modifiedDate,
  keywords,
  noindex,
  animation,
  accent
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type={type}
  kind={kind}
  publishedDate={publishedDate}
  modifiedDate={modifiedDate}
  keywords={keywords}
  noindex={noindex}
  animation={animation}
  accent={accent}
>
  {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
  <slot />
</BaseLayout>
