# Afterwords TTS voice override
.afterwords

# OS files
.DS_Store

# IDE
.vscode/

# Dependencies — site/.gitignore only covers site/node_modules/, not the root
node_modules/

# Superpowers brainstorm artifacts
.superpowers/
.wrangler/

# Audio/video — served from R2 CDN, never committed to git
# These patterns cover both the source (site/public/) and deployment (docs/) directories.
docs/audio/
docs/video/
site/public/audio/
site/public/video/
*.m4a
*.mp3
*.wav
*.ogg
*.mp4
*.webm
*.mov
*.avi
*.mkv

# Root-level audio in site/public/ (podcast episodes, blog audio)
site/public/*.m4a

# Build output — source of truth is site/public/_headers, not these
dist/
docs/_headers